PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart-link-router
ADMIN_SECRET=admin123
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Chatbot + n8n
# Production webhook URL from your n8n workflow (Webhook node)
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/skinaa-chat
# Shared secret: send as header x-chat-secret (backend → n8n and n8n → /api/chat/reply)
N8N_CHAT_SECRET=change-me-chat-secret
